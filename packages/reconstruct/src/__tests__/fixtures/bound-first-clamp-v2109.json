    "tags": null,
    "decompiled": "\n/* WARNING: Enum \"eCollisionFlags\": Some values do not have unique names */\n/* WARNING: Enum \"eD2TimerType\": Some values do not have unique names */\n/* WARNING: Enum \"eD2TimerTypeDWORD\": Some values do not have unique names */\n/* @function MISSILESMODE_SrvDoFn14_GrimWard\n   @address Game.exe.ram:005aef70\n   @date 2026.06.20\n   @calling __fastcall\n   @description Per-tick server update: every Param1 frames dispatches a secondary skill do-function\n   (missiles.txt Param2 index) via SKILLS_DispatchSrvDoFunc for the missile's skill+level, then\n   calls SrvDoFunc_001. Acts as a periodic skill trigger embedded in a missile's flight. */\n\nint __fastcall\nD2Game::MISSILES::MissilesMode::MISSILESMODE_SrvDoFn14_GrimWard(SGAMEDATA *pGame,D2UnitStrc *pUnit)\n\n{\n  D2MissilesTxt *pMissilesTxt;\n  int32_t nRemainingFrames;\n  eD2Skills eSkill;\n  int nClassId;\n  \n  if ((((pUnit == (D2UnitStrc *)0x0) || (nClassId = pUnit->nClassId, nClassId < 0)) ||\n      (D2Common::ITEMS::Items::sgptDataTable->nTxtMissilesSize <= nClassId)) ||\n     (pMissilesTxt = D2Common::ITEMS::Items::sgptDataTable->pTxtMissiles + nClassId,\n     pMissilesTxt == (D2MissilesTxt *)0x0)) {\n    return 2;\n  }\n  nClassId = 1;\n  if (0 < pMissilesTxt->Param1) {\n    nClassId = pMissilesTxt->Param1;\n  }\n  nRemainingFrames = D2Common::Units::Missile::GetRemainingFrames(pUnit);\n  if (nRemainingFrames % nClassId != 0) {\n    nClassId = D2Game::MISSILES::MissilesMode::MISSMODE_SrvDoFn01_BasicMissile(pGame,pUnit);\n    return nClassId;\n  }\n  eSkill = D2Common::Units::Missile::GetSkillId(pUnit);\n  nRemainingFrames = D2Common::Units::Missile::GetLevel(pUnit);\n  if ((0 < (int)eSkill) && (0 < nRemainingFrames)) {\n    D2Game::SKILLS::SkillsServer::SKILLS_DispatchSrvDoFunc\n              (pGame,pUnit,pMissilesTxt->Param2,eSkill,nRemainingFrames);\n    nClassId = D2Game::MISSILES::MissilesMode::MISSMODE_SrvDoFn01_BasicMissile(pGame,pUnit);\n    return nClassId;\n  }\n  return 2;\n}\n\n"
