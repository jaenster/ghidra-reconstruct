    "decompiled": "\n/* @function UI_ToggleHirelingIconsVisibility\n   @address Game.exe.ram:00493840\n   @date 2026.06.06\n   @calling __stdcall\n   @description Diablo 2 1.14d reverse team\n   https://blizzhackers.dev */\n\nvoid D2Client::UI::Hireables::UI_ToggleHirelingIconsVisibility(void)\n\n{\n  eD2GSGameType eGameType;\n  \n  if (gnHireDisplayMode == 0) {\n    eGameType = D2Client::GAME::Game::CLIENT_GetD2GSGameType();\n    if (eGameType == GAMETYPE_SINGLEPLAYER) {\n      gnHireDisplayMode = 2;\n      gnHireIconHoverIndex = 0;\n      D2Client::UI::ui::SetUIFlag(UI_HIREICONS,UI_RESET,0);\n      return;\n    }\n    gnHireDisplayMode = 1;\n    D2Client::UI::ui::SetUIFlag(UI_HIREICONS,UI_SET,0);\n    return;\n  }\n  if (gnHireDisplayMode != 1) {\n    gnHireDisplayMode = 0;\n    D2Client::UI::ui::SetUIFlag(UI_HIREICONS,UI_SET,0);\n    return;\n  }\n  eGameType = D2Client::GAME::Game::CLIENT_GetD2GSGameType();\n  if (eGameType == GAMETYPE_SINGLEPLAYER) {\n    gnHireDisplayMode = 0;\n    D2Client::UI::ui::SetUIFlag(UI_HIREICONS,UI_SET,0);\n    return;\n  }\n  gnHireDisplayMode = 2;\n  gnHireIconHoverIndex = 0;\n  D2Client::UI::ui::SetUIFlag(UI_HIREICONS,UI_RESET,0);\n  return;\n}\n\n",
