      "namespace": "D2Direct3D::d3dFloorCache",
      "decompiled": "\n/* Evicts the least-recently-used node of a D3D floor-texture cache: unlinks the head of the used\n   list, clears its tile's nTextureCacheIndex, appends it to the free list. D3D twin of\n   GLFLOOR_EvictLRU (0050f6d0) without the null-tile halt.\n   Provenance: 1.14d asm 006bb330..006bb38a; no references (EnsureAvailableNode inlines the same\n   body). */\n\nvoid __fastcall D2Direct3D::d3dFloorCache::D3DFLOOR_EvictLRU(D3DFloorCacheStrc *pCache)\n\n{\n  D3DFloorCacheNodeStrc *pEvictNode;\n  D3DFloorCacheNodeStrc *pNextNode;\n  \n  if (pCache->nUsedCount != 0) {\n    pEvictNode = pCache->pUsedHead;\n    if (pEvictNode != (D3DFloorCacheNodeStrc *)0x0) {\n      pNextNode = pEvictNode->pNext;\n      pCache->pUsedHead = pNextNode;\n      if (pNextNode == (D3DFloorCacheNodeStrc *)0x0) {\n        pCache->pUsedTail = (D3DFloorCacheNodeStrc *)0x0;\n      }\n      else {\n        pNextNode->pPrev = (D3DFloorCacheNodeStrc *)0x0;\n      }\n      pEvictNode->pNext = (D3DFloorCacheNodeStrc *)0x0;\n      pEvictNode->pPrev = (D3DFloorCacheNodeStrc *)0x0;\n      if (pEvictNode->pTile != (D2TileLibraryEntryStrc *)0x0) {\n        pEvictNode->pTile->nTextureCacheIndex = 0;\n        pEvictNode->pTile = (D2TileLibraryEntryStrc *)0x0;\n      }\n      if (pCache->pFreeHead == (D3DFloorCacheNodeStrc *)0x0) {\n        pCache->nUsedCount = pCache->nUsedCount + -1;\n        pCache->pFreeHead = pEvictNode;\n        pCache->pFreeTail = pEvictNode;\n        return;\n      }\n      pCache->pFreeTail->pNext = pEvictNode;\n      pEvictNode->pPrev = pCache->pFreeTail;\n      pCache->pFreeTail = pEvictNode;\n    }\n    pCache->nUsedCount = pCache->nUsedCount + -1;\n  }\n  return;\n}\n\n",
