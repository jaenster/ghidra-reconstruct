      "decompiled": "\n/* WARNING: Enum \"eCollisionFlags\": Some values do not have unique names */\n/* WARNING: Enum \"eD2TimerType\": Some values do not have unique names */\n/* WARNING: Enum \"eD2TimerTypeDWORD\": Some values do not have unique names */\n/* @function Q33_OnPresetObjectLoad1\n   @address Game.exe.ram:0058ad80\n   @date 2026.06.13\n   @params\n     this: ECX:4 (auto) (void *)\n     pPresetUnit: Stack[0x4]:4 (D2PresetUnitStrc *)\n   @calling __thiscall\n   @description Q33_OnPresetObjectLoad1 (PrisonOfIce): on preset-unit load, copies the preset object\n   list into pA5Q3->pDrlgMap; if the\n   frozen Anya is already spawned and present, hands the DRLG map file over to its monster map AI\n   (once). Restores ice-Anya\n   visuals/AI when the level region (re)loads. */\n\nvoid __thiscall\nD2Game::Quests::QUESTS::A5Q3::Q33_OnPresetObjectLoad1(void *this,D2MapAIStrc *pMapAI)\n\n{\n  D2QuestDataStrc *pQuestData;\n  D2MapAIStrc *pCopiedPreset;\n  D2UnitStrc *pFrozenAnya;\n  D2MapAIStrc **ppMonsterMapAi;\n  D2MapAIStrc **ppDrlgMap;\n  D2QuestDataA5Q3Strc *pQuestSpecificData;\n  \n  pQuestData = D2Game::Quests::QUESTS::GetQuestDataByQuestNoInternal(this,QUESTINT_PrisonOfIce);\n  if ((pQuestData != (D2QuestDataStrc *)0x0) &&\n     (pQuestSpecificData = (pQuestData->pQuestSpecificData).pA5Q3, pMapAI != (D2MapAIStrc *)0x0)) {\n    ppDrlgMap = &pQuestSpecificData->pDrlgMap;\n    pCopiedPreset =\n         D2Common::Drlg::Preset::DRLGPRESET_CopyMapAI(pQuestData->pGame->pMemoryPool,pMapAI);\n    *ppDrlgMap = pCopiedPreset;\n    if (((pQuestSpecificData->bFrozenAnyaSpawned != 0) &&\n        (((pFrozenAnya = D2Game::UNIT::SUnit::FindUnitFromTable\n                                   (pQuestData->pGame,UNIT_MONSTER,\n                                    pQuestSpecificData->nFrozenAnyaGUID),\n          pFrozenAnya != (D2UnitStrc *)0x0 && (*ppDrlgMap != (D2MapAIStrc *)0x0)) &&\n         ((*ppDrlgMap)->pPosition != (D2PathPosStrc *)0x0)))) &&\n       (pQuestSpecificData->bDrlgMapTaken == 0)) {\n      ppMonsterMapAi = D2Game::Ai::AiGeneral::GetMonsterMapAi(pFrozenAnya);\n      D2Common::Drlg::Preset::DRLGPRESET_TransferMapAI(ppDrlgMap,ppMonsterMapAi);\n      pQuestSpecificData->bDrlgMapTaken = 1;\n    }\n  }\n  return;\n}\n\n"
