      "decompiled": "\n/* WARNING: Enum \"eCollisionFlags\": Some values do not have unique names */\n/* WARNING: Enum \"eD2TimerType\": Some values do not have unique names */\n/* WARNING: Enum \"eD2TimerTypeDWORD\": Some values do not have unique names */\n/* @function Q33_OnPresetObjectLoad2\n   @address Game.exe.ram:0058ae10\n   @date 2026.06.13\n   @params\n     this: ECX:4 (auto) (void *)\n     pPresetUnit: Stack[0x4]:4 (D2PresetUnitStrc *)\n   @calling __thiscall\n   @description Q33_OnPresetObjectLoad2 (PrisonOfIce): same as Load1 but for the rescued-Anya\n   monster (field_0x108 map) \u00e2\u20ac\u201d copies the\n   preset list and transfers the DRLG map file to the Anya monster's AI once it is alive. Restores\n   rescued-Anya on reload. */\n\nvoid __thiscall\nD2Game::Quests::QUESTS::A5Q3::Q33_OnPresetObjectLoad2(void *this,D2MapAIStrc *pMapAI)\n\n{\n  D2QuestDataStrc *pQuestData;\n  D2MapAIStrc *pCopiedPreset;\n  D2UnitStrc *pAnyaCorpse;\n  D2MapAIStrc **ppMonsterMapAi;\n  D2MapAIStrc **pDrlgMapField;\n  D2QuestDataA5Q3Strc *pQuestSpecificData;\n  \n  pQuestData = D2Game::Quests::QUESTS::GetQuestDataByQuestNoInternal(this,QUESTINT_PrisonOfIce);\n  if ((pQuestData != (D2QuestDataStrc *)0x0) && (pMapAI != (D2MapAIStrc *)0x0)) {\n    pQuestSpecificData = (pQuestData->pQuestSpecificData).pA5Q3;\n    pDrlgMapField = &pQuestSpecificData->pAnyaRescuedDrlgMap;\n    pCopiedPreset =\n         D2Common::Drlg::Preset::DRLGPRESET_CopyMapAI(pQuestData->pGame->pMemoryPool,pMapAI);\n    *pDrlgMapField = pCopiedPreset;\n    if (((pQuestSpecificData->bAnyaMonsterAlive != 0) &&\n        (((pAnyaCorpse = D2Game::UNIT::SUnit::FindUnitFromTable\n                                   (pQuestData->pGame,UNIT_MONSTER,\n                                    pQuestSpecificData->nAnyaCorpseGUID),\n          pAnyaCorpse != (D2UnitStrc *)0x0 && (*pDrlgMapField != (D2MapAIStrc *)0x0)) &&\n         ((*pDrlgMapField)->pPosition != (D2PathPosStrc *)0x0)))) &&\n       (pQuestSpecificData->bAnyaRescuedMapTaken == 0)) {\n      ppMonsterMapAi = D2Game::Ai::AiGeneral::GetMonsterMapAi(pAnyaCorpse);\n      D2Common::Drlg::Preset::DRLGPRESET_TransferMapAI(pDrlgMapField,ppMonsterMapAi);\n      pQuestSpecificData->bAnyaRescuedMapTaken = 1;\n    }\n  }\n  return;\n}\n\n"
