# Reconstruction regen config. Copy to scripts/.env (gitignored) and fill in.
# --- Ghidra source program (PRIVATE: use your own server/path) ---
GHIDRA_PROJECT_PATH=ghidra://YOUR_GHIDRA_SERVER:13100/YourProject
GHIDRA_PROGRAM_PATH=/path/to/Program.exe
GHIDRA_DAEMON_URL=http://localhost:8433
GHIDRA_MCP_TOKEN=local
# --- Where the reconstructed C++ is synced + measured ---
RECON_OUTPUT_REPO=/path/to/output-repo
# --- For start-daemon.sh ---
GHIDRA_MCP_DIR=/path/to/ghidra-mcp
GHIDRA_HOME=/path/to/ghidra_PUBLIC
GHIDRA_SERVER_PASSWORD_FILE=$HOME/.ghidra-mcp-server-password
GHIDRA_MCP_PORT=8433
